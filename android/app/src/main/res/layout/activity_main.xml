<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Classroom Monitor"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Render Server URL (https://...)"
        android:textColor="#FFFFFF"
        android:textColorHint="#777777"
        android:inputType="textUri"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etStudentName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Student Name / Roll Number"
        android:textColor="#FFFFFF"
        android:textColorHint="#777777"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Monitoring"
        android:backgroundTint="#3B82F6"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnMinimize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Minimize & Open Study App"
        android:backgroundTint="#10B981"
        android:textColor="#FFFFFF"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Disconnected"
        android:textColor="#AAAAAA"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvPipNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● Monitoring Active in Floating Mode"
        android:textColor="#10B981"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
